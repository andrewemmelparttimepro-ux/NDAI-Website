{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/site", "destination": "/index.html" },
    { "source": "/gallery", "destination": "/index.html" },
    { "source": "/terminal", "destination": "/index.html" },
    { "source": "/term", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|svg|ico|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|xml|txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
